APP_PORT=3000
MYSQL_DATABASE=ograf
MYSQL_USER=ograf
MYSQL_PASSWORD=ograf
MYSQL_ROOT_PASSWORD=replace-me
SESSION_SECRET=replace-with-a-long-random-value
# Encrypts account tokens at rest. Required in production: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TRUST_PROXY=loopback,linklocal,uniquelocal
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Host name (or http(s) origin) of the renderer. Empty: same host as the main page.
RENDERER_HOST=
