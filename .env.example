APP_PORT=3000
MYSQL_DATABASE=ograf
MYSQL_USER=ograf
MYSQL_PASSWORD=ograf
MYSQL_ROOT_PASSWORD=replace-me
SESSION_SECRET=replace-with-a-long-random-value
# Encrypts account tokens at rest. Required in production: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TRUST_PROXY=loopback,linklocal,uniquelocal
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Google sign-in, shown as "Login with YouTube". Leave empty to hide it. Create the OAuth client (type "Web application")
# in the Google Cloud console and register this exact redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Host name (or http(s) origin) of the renderer, e.g. render.example.com. Empty: same host as the main page.
RENDERER_HOST=
# Host names of the main page (comma separated, e.g. grafanaut.example.com). Package assets and media files are only
# served to pages on these hosts or the renderer host (Referer check).
APP_HOST=
# strict (Referer required), lenient (missing Referer allowed) or off. Empty: strict with RENDERER_HOST, else lenient.
# Media files are always served without Referer; foreign referers are refused unless this is off.
ASSET_REFERER_CHECK=
# Largest media library upload in bytes (default 20 MB). Allowed types: UPLOAD_ALLOWED_EXTENSIONS.
MEDIA_MAX_BYTES=20971520
# Upload limits for the private catalog (defaults shown). UPLOAD_ALLOWED_EXTENSIONS is a comma-separated list;
# empty uses the default list (see README).
UPLOAD_MAX_ZIP_BYTES=10485760
UPLOAD_MAX_UNCOMPRESSED_BYTES=52428800
UPLOAD_MAX_FILES=5000
UPLOAD_ALLOWED_EXTENSIONS=
