# Port of the stack's proxy, to which your HTTPS reverse proxy forwards all host names (see INSTALLATION.md).
APP_PORT=3000
# Largest request body the proxy accepts (nginx size). At least UPLOAD_MAX_ZIP_BYTES and MEDIA_MAX_BYTES.
PROXY_MAX_BODY_SIZE=25m
MYSQL_DATABASE=ograf
MYSQL_USER=ograf
MYSQL_PASSWORD=ograf
MYSQL_ROOT_PASSWORD=replace-me
# Signs the session cookies. Required in production (at least 32 characters): openssl rand -base64 48
SESSION_SECRET=
# Encrypts account tokens at rest. Required in production: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TRUST_PROXY=loopback,linklocal,uniquelocal
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Google sign-in, shown as "Login with YouTube". Leave empty to hide it. Create the OAuth client (type "Web application")
# in the Google Cloud console and register this exact redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Accounts with the admin role (user list, catalog tags), comma separated: provider:login or provider:user-id,
# e.g. twitch:jeluf, google:112233445566778899
ADMIN_USERS=
# Host names, one each, without scheme or path (required with Docker Compose). The stack's proxy routes them
# (proxy/default.conf.template); redirect alternate names (e.g. www.) to APP_HOST outside Grafonaut.
# Main host: the app, its API, the MCP interface and the icon server.
APP_HOST=
# Renderer page, e.g. render.example.com.
RENDERER_HOST=
# Graphic frames, package and media files, e.g. graphics.example.com. Required for graphics that script their own
# HTML pages (SPX templates).
GRAPHICS_HOST=
# strict (Referer required), lenient (missing Referer allowed) or off. Empty: strict with GRAPHICS_HOST, else lenient.
# Media files are always served without Referer; foreign referers are refused unless this is off.
ASSET_REFERER_CHECK=
# Largest media library upload in bytes (default 20 MB). Allowed types: UPLOAD_ALLOWED_EXTENSIONS.
MEDIA_MAX_BYTES=20971520
# Upload limits for the private catalog (defaults shown). UPLOAD_ALLOWED_EXTENSIONS is a comma-separated list;
# empty uses the default list (see USER-GUIDE.md).
UPLOAD_MAX_ZIP_BYTES=10485760
UPLOAD_MAX_UNCOMPRESSED_BYTES=52428800
UPLOAD_MAX_FILES=5000
UPLOAD_ALLOWED_EXTENSIONS=
# MCP interface for AI assistants (see MCP.md) at https://<APP_HOST>/mcp: true or false.
MCP_ENABLED=false
# Origins of browser-based MCP clients allowed to call /mcp directly, comma separated. Usually empty.
MCP_ALLOWED_ORIGINS=
