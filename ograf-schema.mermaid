erDiagram
    ACCOUNTS {
        bigint id PK
        varchar64 twitch_user_id UK
        varchar64 twitch_login UK "used in logs instead of the API token, §5"
        varchar64 twitch_display_name
        boolean is_approver "additive role, §4 - Approver is also a User"
        varbinary255 api_token_encrypted "AES-256-GCM ciphertext, decryptable on demand, §5"
        tinyint api_token_key_version "which server-held key encrypted this value"
        datetime api_token_created_at
        datetime created_at
        datetime updated_at
    }

    PACKAGES {
        char36 id PK "UUID, also the storage dir name, §7"
        bigint owner_account_id FK "NULL = platform/seed-provided"
        varchar255 manifest_id "informational only, never used for paths, §7"
        varchar255 display_name "denormalized cache of current/latest version's name"
        char36 latest_version_id FK "most recent upload, for owner's private/testing use"
        char36 current_published_version_id FK "version currently live in the public catalog"
        boolean disabled "personal or moderation kill-switch, §3/§11"
        bigint disabled_by_account_id FK
        datetime disabled_at
        datetime created_at
        datetime updated_at
    }

    PACKAGE_VERSIONS {
        char36 id PK "UUID, also the storage dir name, §7"
        char36 package_version_id FK "immutable selected version; upgrades are manual, §7/§8"
        varchar64 version_label "manifest's own declared version string"
        varchar255 manifest_name
        text manifest_description
        json manifest_json "full parsed manifest incl. schema, drives FE-5"
        varchar512 main_file_relpath "validated .mjs entry point path, §6"
        char64 zip_checksum_sha256 "used for the rejected-resubmission block, §6/§7"
        int zip_size_bytes "must be <= 10 MB, §6"
        int uncompressed_size_bytes "must be <= 50 MB, §6"
        int file_count "must be <= 5000, §6"
        enum source "user_upload / seed_builtin / seed_volume, §2/§6"
        bigint uploaded_by_account_id FK "NULL for seed-imported versions"
        enum review_state "draft / pending / published / rejected, §11"
        datetime submitted_for_review_at
        bigint reviewed_by_account_id FK
        datetime reviewed_at
        text reviewer_note "optional on approval, required on rejection, §11"
        datetime created_at
    }

    MY_GRAPHICS_ENTRIES {
        bigint id PK
        bigint account_id FK "the entry's owner (not necessarily the package owner)"
        char36 package_id FK
        varchar100 label "e.g. Left / Right, §3"
        json schema_data "this entry's own independent property values, §3/§8"
        boolean enabled "per-entry personal toggle, independent of packages.disabled"
        int sort_order
        datetime created_at
        datetime updated_at
    }

    ACTION_GROUPS {
        bigint id PK
        bigint account_id FK
        varchar100 name
        int sort_order
        datetime created_at
        datetime updated_at
    }

    ACTION_GROUP_STEPS {
        bigint id PK
        bigint action_group_id FK
        bigint my_graphics_entry_id FK
        enum action_type "play / stop / update, §3/FE-7"
        json action_payload "e.g. partial data for an update step"
        int step_order
    }

    RENDERER_CONNECTIONS {
        bigint id PK
        bigint account_id FK
        varchar100 label "e.g. OBS - Main PC, Browser test, §10"
        datetime connected_at
        datetime last_seen_at
        datetime disconnected_at "NULL while still connected"
    }

    ACCOUNTS ||--o{ PACKAGES : owns
    ACCOUNTS ||--o{ PACKAGES : disables
    ACCOUNTS ||--o{ PACKAGE_VERSIONS : uploads
    ACCOUNTS ||--o{ PACKAGE_VERSIONS : reviews
    PACKAGES ||--o{ PACKAGE_VERSIONS : has
    PACKAGES ||--o| PACKAGE_VERSIONS : "latest version"
    PACKAGES ||--o| PACKAGE_VERSIONS : "current published version"
    ACCOUNTS ||--o{ MY_GRAPHICS_ENTRIES : owns
    PACKAGE_VERSIONS ||--o{ MY_GRAPHICS_ENTRIES : "selected version"
    ACCOUNTS ||--o{ ACTION_GROUPS : defines
    ACTION_GROUPS ||--o{ ACTION_GROUP_STEPS : contains
    MY_GRAPHICS_ENTRIES ||--o{ ACTION_GROUP_STEPS : "targeted by"
    ACCOUNTS ||--o{ RENDERER_CONNECTIONS : connects
